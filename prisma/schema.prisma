// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum InvitationStatus {
  ACTIVE
  REVOKED
}

enum ProjectRole {
  PROJECT_MANAGER
  REVIEWER
  EDITOR
  TRANSLATOR
}

enum SourceProjectStatus {
  ACTIVE
  COMPLETE
}

enum DocumentStatus {
  PENDING_TRANSLATION
  IN_PROGRESS
  PENDING_REVIEW
  APPROVED
  DEPLOYED
}

enum SuggestionType {
  COMMENT // Pouze komentář
  CHANGE // Návrh změny s proposedText
}

enum SuggestionStatus {
  OPEN // Otevřený návrh
  APPLIED // Aplikován překladatelem
  DISMISSED // Odmítnut
}

enum DocumentType {
  DAY
  FIELD_GUIDE
  DAILY_CONTENT
  ROOT_FILE
  MEETING
}

enum TShirtSize {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
}

enum GitHubPRStatus {
  OPEN
  MERGED
  CLOSED
}

enum AudioProvider {
  AZURE_SPEECH
}

enum AudioStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum AnnouncementType {
  BANNER
  MODAL
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  name                   String
  emailVerified          Boolean                 @default(false)
  image                  String?
  role                   Role                    @default(USER)
  banned                 Boolean                 @default(false)
  banReason              String?
  banExpires             DateTime?
  streetAddress          String?
  city                   String?
  state                  String?
  zipCode                String?
  country                String?
  tShirtSize             TShirtSize?
  exodus90AppId          String?
  onboarded              Boolean                 @default(false)
  sessions               Session[]
  accounts               Account[]
  documentVersions       DocumentVersion[]
  reviewedVersions       DocumentVersion[]       @relation("ReviewedBy")
  comments               Comment[]
  activityLogs           ActivityLog[]
  assignedVersions       DocumentVersion[]       @relation("AssignedBy")
  languages              UserLanguage[]
  suggestions            Suggestion[]
  triggeredAudioFiles    AudioFile[]
  suggestionReplies      SuggestionReply[]
  invitationsCreated     Invitation[]            @relation("InvitationsCreated")
  announcementDismissals AnnouncementDismissal[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  // Supports the per-user last-seen aggregate on the admin users page.
  @@index([userId, updatedAt])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // better-auth looks accounts up by user on every credential sign-in.
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Language {
  id                      String               @id @default(uuid())
  code                    String               @unique // e.g., "en", "cs", "de"
  name                    String // e.g., "English", "Czech", "German"
  translationInstructions String?              @db.Text
  branchName              String?
  audioProvider           AudioProvider?
  audioVoice              String? // provider voice id, e.g. "cs-CZ-AntoninNeural"
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  documentVersions        DocumentVersion[]
  translationProjects     TranslationProject[]
  users                   UserLanguage[]
  invitations             InvitationLanguage[]

  @@map("language")
}

model Folder {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  documents Document[]

  @@map("folder")
}

model SourceProject {
  id                  String               @id @default(uuid())
  name                String               @unique
  description         String?              @db.Text
  identifier          String               @unique // URL segment: /documents/{identifier}/...
  acronym             String? // Short prefix for auto-named DAY titles, e.g. "SML" in "SML - DAY 03 - ..."
  status              SourceProjectStatus  @default(ACTIVE)
  audioDocumentTypes  DocumentType[]       @default([DAY, DAILY_CONTENT])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  documents           Document[]
  translationProjects TranslationProject[]

  @@map("source_project")
}

model TranslationProject {
  id              String        @id @default(uuid())
  name            String
  sourceProjectId String
  sourceProject   SourceProject @relation(fields: [sourceProjectId], references: [id], onDelete: Cascade)
  languageId      String
  language        Language      @relation(fields: [languageId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([sourceProjectId, languageId])
  // Language-based access resolution walks this the other way round, so the
  // composite unique's sourceProjectId-first ordering does not serve it.
  @@index([languageId])
  @@map("translation_project")
}

model Document {
  id               String            @id @default(uuid())
  slug             String // unique within the source project, see @@unique below
  title            String
  labels           String[] // Array of labels for categorization
  deadline         DateTime? // Optional deadline for translation completion
  type             DocumentType?
  folderId         String? // Deprecated - kept for migration
  folder           Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  sourceProjectId  String?
  sourceProject    SourceProject?    @relation(fields: [sourceProjectId], references: [id], onDelete: SetNull)
  originalFilename String? // Original filename when uploaded (e.g., "1.md")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  versions         DocumentVersion[]

  @@unique([sourceProjectId, slug])
  // Every document list orders by this.
  @@index([updatedAt])
  @@map("document")
}

model DocumentVersion {
  id            String         @id @default(uuid())
  documentId    String
  document      Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  languageId    String
  language      Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)
  content       String         @db.Text // Markdown content
  status        DocumentStatus @default(PENDING_TRANSLATION)
  version       Int            @default(1)
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  reviewerId    String?
  reviewer      User?          @relation("ReviewedBy", fields: [reviewerId], references: [id], onDelete: SetNull)
  // Assignment lives here rather than in a separate record, so a document's
  // translator, reviewer, deadline and status can never drift apart.
  deadline      DateTime?
  assignedById  String?
  assignedBy    User?          @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  comments      Comment[]
  activityLogs  ActivityLog[]
  suggestions   Suggestion[]
  githubCommits GitHubCommit[]
  audioFiles    AudioFile[]

  @@unique([documentId, languageId])
  // The dashboard's "My Work" filters on OR(userId, reviewerId); the
  // translation-project list filters on languageId; the deploy queue on status.
  @@index([userId])
  @@index([reviewerId])
  @@index([languageId])
  @@index([status])
  @@map("document_version")
}

model Comment {
  id                String          @id @default(uuid())
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  content           String          @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([documentVersionId])
  @@map("comment")
}

model ActivityLog {
  id                String          @id @default(uuid())
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  action            String // e.g., "created", "edited", "submitted_for_review", "approved", "deployed"
  details           Json? // Additional details about the action
  createdAt         DateTime        @default(now())

  // Supports the per-user last-document-edit aggregate on the admin users page
  // (grows unboundedly, so the aggregate must not full-scan).
  @@index([action, userId, createdAt])
  @@map("activity_log")
}

/// Grants a user access to every translation project in this language, with the
/// given role. Replaces the former per-project ProjectMember records.
model UserLanguage {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  languageId String
  language   Language    @relation(fields: [languageId], references: [id], onDelete: Cascade)
  role       ProjectRole @default(TRANSLATOR)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([userId, languageId])
  // Supports the reviewer/manager lookups that resolve project access by language.
  @@index([languageId, role])
  @@map("user_language")
}

model Suggestion {
  id                String          @id @default(uuid())
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Range v textu (Monaco formát) - optional for general (unanchored) threads
  startLine   Int?
  startColumn Int?
  endLine     Int?
  endColumn   Int?

  // Typ suggestion
  type SuggestionType @default(COMMENT)

  // Obsah
  comment      String  @db.Text
  proposedText String? @db.Text // null pro COMMENT, vyplněno pro CHANGE
  originalText String? @db.Text // Original text before CHANGE was applied, used for revert on reopen

  // Stav
  status          SuggestionStatus @default(OPEN)
  dismissedReason String?          @db.Text

  // Metadata
  version   Int // Verze dokumentu, na které vznikl návrh
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  replies   SuggestionReply[]

  // Serves countOpenSuggestions and the open-suggestion groupBy.
  @@index([documentVersionId, status])
  @@map("suggestion")
}

model SuggestionReply {
  id           String     @id @default(uuid())
  suggestionId String
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String     @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("suggestion_reply")
}

model GitHubCommit {
  id                String          @id @default(uuid())
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  commitSha         String
  branchName        String
  filePath          String
  prNumber          Int?
  prUrl             String?
  prStatus          GitHubPRStatus?
  errorMessage      String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([documentVersionId])
  @@map("github_commit")
}

/// One row per audio generation attempt. Never overwritten: a regeneration
/// creates a new row and a new object, so a copied URL keeps pointing at the
/// file it pointed at when it was copied.
model AudioFile {
  id                String          @id @default(uuid())
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  status            AudioStatus     @default(PENDING)
  provider          AudioProvider
  voice             String
  sourceVersion     Int // DocumentVersion.version the audio was generated from
  providerJobId     String?
  objectKey         String?
  url               String?
  durationMs        Int?
  sizeBytes         Int?
  billedCharacters  Int?
  errorMessage      String?         @db.Text
  triggeredByUserId String?
  triggeredBy       User?           @relation(fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([documentVersionId, createdAt])
  @@index([status, updatedAt])
  @@map("audio_file")
}

model Invitation {
  id          String               @id @default(uuid())
  token       String               @unique
  maxUses     Int? // null = unlimited, 1 = single-use, N = max registrations
  usedCount   Int                  @default(0)
  expiresAt   DateTime
  status      InvitationStatus     @default(ACTIVE)
  createdById String
  createdBy   User                 @relation("InvitationsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  languages   InvitationLanguage[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("invitation")
}

model Announcement {
  id         String                  @id @default(uuid())
  title      String
  body       String?                 @db.Text // Markdown content; modal-only (banners show just the title)
  type       AnnouncementType
  ctaLabel   String?
  ctaUrl     String?
  isActive   Boolean                 @default(false)
  expiresAt  DateTime?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  dismissals AnnouncementDismissal[]

  @@map("announcement")
}

model AnnouncementDismissal {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([announcementId, userId])
  @@map("announcement_dismissal")
}

model InvitationLanguage {
  id           String     @id @default(uuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  languageId   String
  language     Language   @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([invitationId, languageId])
  @@map("invitation_language")
}
