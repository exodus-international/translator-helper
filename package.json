{
  "name": "translation-helper",
  "version": "1.2.0",
  "private": true,
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "node scripts/copy-monaco.mjs && set -a && . ./.env 2>/dev/null; set +a; next dev --port ${PORT:-3000}",
    "build": "node scripts/copy-monaco.mjs && prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "pnpm test:unit && pnpm test:components",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "node scripts/copy-monaco.mjs",
    "format": "prettier --write .",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "release:prepare": "bash scripts/release.sh",
    "release:tag": "bash scripts/release-tag.sh",
    "test:unit": "tsx --test $(find src -name '*.test.ts')",
    "test:components": "tsx --test --import ./tests/setup-dom.ts $(find src -name '*.test.tsx')"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sentry/nextjs": "^10.32.1",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.3.34",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.553.0",
    "monaco-editor": "0.54.0",
    "next": "16.0.7",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "octokit": "^5.0.5",
    "posthog-js": "^1.402.2",
    "prisma": "5.22.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tunnel-rat": "^0.1.2",
    "zod": "^4.1.12",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^15.11.7",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.10.44",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.2",
    "fallow": "^2.48.1",
    "import-in-the-middle": "2.0.1",
    "require-in-the-middle": "^8.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "dotenv",
    "prisma",
    "sharp",
    "unrs-resolver"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@sentry/cli",
      "core-js",
      "esbuild",
      "fallow",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
