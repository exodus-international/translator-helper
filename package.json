{
  "name": "translation-helper",
  "version": "1.3.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "node scripts/copy-monaco.mjs; set -a && . ./.env 2>/dev/null; set +a; next dev --port ${PORT:-3000}",
    "build": "node scripts/copy-monaco.mjs && prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "pnpm test:unit && pnpm test:components",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "node scripts/copy-monaco.mjs",
    "format": "prettier --write .",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "release:prepare": "bash scripts/release.sh",
    "release:tag": "bash scripts/release-tag.sh",
    "test:unit": "files=$(find src -name '*.test.ts'); if [ -z \"$files\" ]; then echo 'no unit tests found'; exit 1; fi; tsx --test $files",
    "test:components": "files=$(find src -name '*.test.tsx'); if [ -z \"$files\" ]; then echo 'no component tests found'; exit 1; fi; tsx --test --import ./tests/setup-dom.ts $files"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/nextjs": "^10.73.0",
    "@tanstack/react-table": "^9.2.4",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "dompurify": "^3.4.14",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "lucide-react": "^1.41.0",
    "marked": "^15.0.12",
    "monaco-editor": "0.56.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "octokit": "^5.0.5",
    "posthog-js": "^1.427.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tunnel-rat": "^0.1.2",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^15.11.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "baseline-browser-mapping": "^2.11.21",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "fallow": "^3.22.0",
    "import-in-the-middle": "3.4.0",
    "prisma": "7.10.0",
    "require-in-the-middle": "^8.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
