{
  "name": "translation-helper",
  "version": "1.2.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "set -a && . ./.env 2>/dev/null; set +a; next dev --port ${PORT:-3000}",
    "build": "node scripts/copy-monaco.mjs && prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test $(find src -name '*.test.ts' -o -name '*.test.tsx')",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "node scripts/copy-monaco.mjs",
    "format": "prettier --write .",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "release:prepare": "bash scripts/release.sh",
    "release:tag": "bash scripts/release-tag.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@sentry/nextjs": "^10.73.0",
    "@tanstack/react-table": "^9.2.4",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.3",
    "js-yaml": "^4.3.2",
    "lucide-react": "^1.41.0",
    "monaco-editor": "0.56.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "octokit": "^5.0.5",
    "posthog-js": "^1.427.2",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tunnel-rat": "^0.1.2",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "baseline-browser-mapping": "^2.11.21",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "fallow": "^3.22.0",
    "import-in-the-middle": "2.0.1",
    "prisma": "7.10.0",
    "require-in-the-middle": "^8.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "dotenv",
    "prisma",
    "sharp",
    "unrs-resolver"
  ],
  "pnpm": {
    "overrides": {
      "js-yaml@<3.15.0": ">=3.15.0",
      "mdast-util-to-hast@<13.2.1": ">=13.2.1",
      "@babel/core@<=7.29.0": ">=7.29.6",
      "dompurify@<=3.4.11": ">=3.4.12",
      "browserslist@<=4.28.6": ">=4.28.7"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@sentry/cli",
      "core-js",
      "esbuild",
      "fallow",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
