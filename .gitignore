# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

.pnpm-store/

# Sentry Config File
.env.sentry-build-plugin
.fallow/

# Monaco is vendored into public/ by scripts/copy-monaco.mjs on postinstall
/public/monaco/

# Playwright MCP session artifacts
.playwright-mcp/

# Staging area for uploaded brand artwork; derived files are committed instead
generated-images/
