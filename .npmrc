# Nixpacks, which Coolify builds with, only maps "packageManager" majors up to
# 10, so for our pnpm@12 pin it falls back to the lockfile and installs pnpm 9.
# pnpm 9 does not self-manage to the pinned version unless asked; this setting
# is what makes it bootstrap to 12.x before it installs anything. pnpm 10+
# defaults to true, so this is a no-op locally and in CI.
manage-package-manager-versions=true
